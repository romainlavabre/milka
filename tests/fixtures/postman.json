{
  "info": {
    "_postman_id": "8a1c7f6e-0000-0000-0000-000000000000",
    "name": "Blog API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create post",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('created', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "pm.environment.set('postId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"title\": \"Hello\"}", "options": { "raw": { "language": "json" } } },
            "url": {
              "raw": "{{baseUrl}}/posts?draft=true",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [{ "key": "draft", "value": "true" }]
            }
          },
          "response": [
            {
              "name": "Without title",
              "originalRequest": {
                "method": "POST",
                "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
                "url": { "raw": "{{baseUrl}}/posts" }
              },
              "code": 400
            }
          ]
        },
        {
          "name": "Get post",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/posts/:id", "variable": [{ "key": "id", "value": "{{postId}}" }] }
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "auth": { "type": "noauth" },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "user", "value": "ada" },
            { "key": "password", "value": "{{password}}" }
          ]
        },
        "url": "{{baseUrl}}/login"
      }
    }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [{ "key": "baseUrl", "value": "https://blog.example.com" }]
}
